FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

expressions
 (
  S 
        {
            field S; //field to initialise
            expression "1.";
            condition "pos().x < 0.0";
            keepPatches 1;
        }
 );

