FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      bedloadProperties;
}

// ************************** sediment properties ************************** //

sedimentBed            off;  // on or off

bedMotion              off;

sedimentBedPatches     (bed);

bedload                off;

bedloadModel
{
    type               custom;
    alpha              32;
    aExp               0.5;
    bExp               1;
    slopeCorrection    off;

    avalanche          on;
    Qav                3e-4;
    NfiltBeta          0;
    alphaFiltBeta      0.2;
    onEdge             off;
}

criticalShieldsModel
{
    type               fixedValue;
    value              0.05;
    slopeCorrection    on;
}

saturation
{
    Tsat               0.01;
    Lsat               0.005;
}

rigidBed               off;

CsbMax                 0.3;

